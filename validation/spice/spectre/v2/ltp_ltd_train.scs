    1.220001 0 1.26 0 1.260001 -5e-10 1.27 -5e-10 \
    1.270001 0 1.31 0 1.310001 -5e-10 1.32 -5e-10 \
    1.320001 0 1.36 0 1.360001 -5e-10 1.37 -5e-10 \
    1.370001 0 1.41 0 1.410001 -5e-10 1.42 -5e-10 \
    1.420001 0 1.46 0 1.460001 -5e-10 1.47 -5e-10 \
    1.470001 0 1.51 0 1.510001 -5e-10 1.52 -5e-10 \
    1.520001 0 1.56 0 1.560001 -5e-10 1.57 -5e-10 \
    1.570001 0 1.61 0 1.610001 -5e-10 1.62 -5e-10 \
    1.620001 0 1.66 0 1.660001 -5e-10 1.67 -5e-10 \
