    0.620001 0 0.66 0 0.660001 5e-10 0.67 5e-10 \
    0.670001 0 0.71 0 0.710001 5e-10 0.72 5e-10 \
    0.720001 0 0.76 0 0.760001 5e-10 0.77 5e-10 \
    0.770001 0 0.81 0 0.810001 5e-10 0.82 5e-10 \
    0.820001 0 0.86 0 0.860001 5e-10 0.87 5e-10 \
    0.870001 0 0.91 0 0.910001 5e-10 0.92 5e-10 \
    0.920001 0 0.96 0 0.960001 5e-10 0.97 5e-10 \
    0.970001 0 1.01 0 1.010001 -5e-10 1.02 -5e-10 \
    1.020001 0 1.06 0 1.060001 -5e-10 1.07 -5e-10 \
    1.070001 0 1.11 0 1.110001 -5e-10 1.12 -5e-10 \
    1.120001 0 1.16 0 1.160001 -5e-10 1.17 -5e-10 \
