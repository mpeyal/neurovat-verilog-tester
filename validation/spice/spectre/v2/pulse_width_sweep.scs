// pulse_width_sweep.scs - GENERATED by validation/spice/make_netlists.py; do not edit.
// Gate A validation deck: ecfet_v2 under stimulus 'pulse_width_sweep'
//   +200 pA pulses of 2/5/10/20/40 ms, one every 0.5 s
// stimulus set gateA-1 (12659ad495151485), t_stop 3.01 s
//
// Run (writes pulse_width_sweep.raw/tran.tran in PSF-ascii):
//   spectre +escchars -format psfascii -raw pulse_width_sweep.raw +log pulse_width_sweep.log pulse_width_sweep.scs
// then import with validation/scrub_spectre.py (see validation/README.md).

simulator lang=spectre
global 0

ahdl_include "../../../../verilog/ecfet_v2.va"

simOpts options reltol=1e-6 vabstol=1e-12 iabstol=1e-18 gmin=1e-15 temp=27
saveOpts options save=selected

// DUT: module ecfet_v2(In, Out, IGsc, Rmem); defaults = Python twin defaults.
// Out is grounded so the In-Out read loop has a reference node.
X1 (n_in 0 n_igsc n_rmem) ecfet_v2

// read path: 10 mV across In-Out; i(vread) = V_read * G
vread (n_in 0) vsource dc=0.01 type=dc

// gate drive: intended so a positive value flows INTO the IGsc pin (potentiation)
igate (0 n_igsc) isource type=pwl wave=[ 0 0 0.01 0 0.010001 2e-10 0.012 2e-10 \
    0.012001 0 0.51 0 0.510001 2e-10 0.515 2e-10 \
    0.515001 0 1.01 0 1.010001 2e-10 1.02 2e-10 \
    1.020001 0 1.51 0 1.510001 2e-10 1.53 2e-10 \
    1.530001 0 2.01 0 2.010001 2e-10 2.05 2e-10 \
    2.050001 0 3.01 0 ]
Rshunt (n_igsc 0) resistor r=1G   // DC path for the IGsc sense node

// initial state (n_nv = 1/Rinit (also forced by the .va's analysis("ic") branch))
ic X1.n_nv=0.000227272727273 X1.n_v1=0 X1.n_v2=0 X1.n_v3=0

tran tran stop=3.01 maxstep=0.001 errpreset=conservative ic=node

save n_rmem X1.n_nv X1.n_v1 X1.n_v2 X1.n_v3 X1.n_stdp vread:p X1:IGsc
