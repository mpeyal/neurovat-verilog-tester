// gap_sweep.scs - GENERATED by validation/spice/make_netlists.py; do not edit.
// Gate A validation deck: ecfet_v3 under stimulus 'gap_sweep'
//   pairs of +200 pA / 10 ms pulses with 5/20/50/200/1000 ms gaps (volatile relaxation between writes), 1.5 s between pairs
// stimulus set gateA-1 (12659ad495151485), t_stop 8.885 s
//
// Run (writes gap_sweep.raw/tran.tran in PSF-ascii):
//   spectre +escchars -format psfascii -raw gap_sweep.raw +log gap_sweep.log gap_sweep.scs
// then import with validation/scrub_spectre.py (see validation/README.md).

simulator lang=spectre
global 0

ahdl_include "../../../../verilog/ecfet_v3.va"

simOpts options reltol=1e-6 vabstol=1e-12 iabstol=1e-18 gmin=1e-15 temp=27
saveOpts options save=selected

// DUT: module ecfet_v3(In, Out, IGsc, Rmem); defaults = Python twin defaults.
// Out is grounded so the In-Out read loop has a reference node.
X1 (n_in 0 n_igsc n_rmem) ecfet_v3

// read path: 10 mV across In-Out; i(vread) = V_read * G
vread (n_in 0) vsource dc=0.01 type=dc

// gate drive: intended so a positive value flows INTO the IGsc pin (potentiation)
igate (0 n_igsc) isource type=pwl wave=[ 0 0 0.01 0 0.010001 2e-10 0.02 2e-10 \
    0.020001 0 0.025 0 0.025001 2e-10 0.035 2e-10 \
    0.035001 0 1.535 0 1.535001 2e-10 1.545 2e-10 \
    1.545001 0 1.565 0 1.565001 2e-10 1.575 2e-10 \
    1.575001 0 3.075 0 3.075001 2e-10 3.085 2e-10 \
    3.085001 0 3.135 0 3.135001 2e-10 3.145 2e-10 \
    3.145001 0 4.645 0 4.645001 2e-10 4.655 2e-10 \
    4.655001 0 4.855 0 4.855001 2e-10 4.865 2e-10 \
    4.865001 0 6.365 0 6.365001 2e-10 6.375 2e-10 \
    6.375001 0 7.375 0 7.375001 2e-10 7.385 2e-10 \
    7.385001 0 8.885 0 ]
Rshunt (n_igsc 0) resistor r=1G   // DC path for the IGsc sense node

// initial state (n_x and the pools are idt(rate, ic) nodes seeded inside the .va)
// no ic statement: x_init = 0.199853851 (from Rinit)

tran tran stop=8.885 maxstep=0.002 errpreset=conservative ic=node

save n_rmem X1.n_x X1.n_v1 X1.n_v2 X1.n_v3 X1.n_stdp vread:p X1:IGsc
