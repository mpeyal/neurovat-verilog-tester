# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# local Verilog-A toolchain binaries + build artifacts (downloaded, not source)
tools/vasim/bin/
tools/vasim/*.osdi

# compiler / simulator build artifacts (regenerated, not source)
*.osdi
*.exp
*.lib
*.o[0-9]
probe*_tmp.*

# root-level scratch / screenshot scripts
/_*.py

# non-standard .ava backups (va_scan only reads .va)
*.ava

# generated result figures + data (regenerated by run_*.py / the GUI)
results/*.png
results/*.csv
# live model-list cache (refetched from the providers on demand)
results/model_cache.json
# debug logs from the run-and-drive workflow in CLAUDE.md (app_run.log etc.)
results/*.log
results/session_log.txt

# neurovat experiment / benchmark outputs (regenerated from configs/)
results/sweeps/
results/benchmark/
.pytest_cache/
build/
dist/

# downloaded datasets (MNIST etc.) + saved-model JSON (outputs, not source)
/datasets/
results/models/
/saved_model/

# generated slide-deck screenshots (rebuilt by tools/capture_shots.py)
results/deck/

# agent / GUI transient outputs
results/.agent_backup/
results/agent_snapshot.json
results/agent_spec.json
results/agent_out.json
results/neuro_snapshot.json
results/gui_*.csv

# test + screenshot artifacts (generated)
results/_*.png
results/ui_*.png
# disposable GUI verification captures (research figures remain eligible)
results/design_system/*.png
results/design_system/session_log.txt
results/model_builder/*.png
results/model_builder/session_log.txt
results/compute_gui/*.png
results/popup_actions/*.png
results/viewport_layout/*.png
results/viewport_layout/session_log.txt
# rendered pages / intermediate PDF of the retained final Word report
results/mnist_ecfet_v2/report_qa/
# local structural checks from code refactoring
results/refactor_checks/

# editor / OS cruft
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code local config
.claude/

# agent scratch plots in results/
results/stdp_plot.py
results/stdp_plot.png

# control-bridge mailbox (runtime, per-session)
control/

# local Virtuoso login (user@host) - never commit
/virtuoso.local

# local-only demo device: kept on disk for coding tests, never committed or
# bundled into the release exe (CI checks out from git, so it stays out)
/twins/example_rram.va
/twins/example_rram.py
